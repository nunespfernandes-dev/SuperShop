@model SuperShop.Web.Models.Product

@{
    ViewData["Title"] = "Detalhes do Produto";
}

<h1>Detalhes do Produto</h1>

<div>
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Name)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Name)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Price)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Price)</dd>

        <dt class="col-sm-3">Imagem</dt>
        <dd class="col-sm-9">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Name" style="width:150px" class="img-thumbnail" />
            }
            else
            {
                <span class="text-muted">Sem imagem</span>
            }
        </dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.LastPurchase)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.LastPurchase)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.LastSale)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.LastSale)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.IsAvailable)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.IsAvailable)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Stock)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Stock)</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil-square"></i> Editar</a> |
    <a asp-action="Index"><i class="bi bi-arrow-left"></i> Voltar à lista</a>
</div>
