@model SuperShop.Web.Models.ProductViewModel

@{
    ViewData["Title"] = "Novo Produto";
}

<h1>Novo Produto</h1>

<form asp-action="Create" enctype="multipart/form-data">
    <div asp-validation-summary="All" class="text-danger"></div>
    <partial name="_ProductForm" />
    <div class="form-group mt-3">
        <button type="submit" class="btn btn-primary"><i class="fa fa-plus"></i> Criar</button>
    </div>
</form>

<a asp-action="Index"><i class="fa fa-chevron-left"></i> Voltar à lista</a>
